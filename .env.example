# COPY TO .env IN YOUR PROJECT. NEVER COMMIT .env OR REAL SECRETS.
# These values are samples / blank placeholders. Validate all settings at startup.
DATA_MODE=fixture
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# HERE: keep key server-side only
HERE_API_KEY=
HERE_ROUTING_BASE_URL=https://router.hereapi.com/v8
HERE_GEOCODING_BASE_URL=https://geocode.search.hereapi.com/v1

# Open-Meteo: non-commercial endpoint is keyless; paid endpoint requires key.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_API_KEY=

# MapLibre's map style/tiles is a separate licensed provider, not MapLibre itself.
VITE_MAP_STYLE_URL=
VITE_MAP_PUBLIC_TOKEN=

# Data and jobs: omit/disable components not provisioned in the chosen runtime mode.
DATABASE_URL=
REDIS_URL=
ENABLE_ASYNC_PLANNING=false
PLANNING_CONCURRENCY=4
PROVIDER_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_READ_TIMEOUT_SECONDS=20
PROVIDER_MAX_ATTEMPTS=3
PLAN_MAX_ROUTES=3
INTERNAL_SCORING_MILES=10
DEFAULT_DISPLAY_CHECKPOINT_MILES=25
PLAN_RESULT_TTL_SECONDS=3600
WEATHER_CACHE_TTL_SECONDS=900
MAX_CHECKPOINTS_PER_ROUTE=600
MAX_CONCURRENT_PLANS_PER_SCOPE=2

# This is an EXAMPLE config. Deployment must adjust limits/TTL according to evidence,
# provider terms and resource budgets. The assessment's weather thresholds belong in
# a versioned backend risk policy, not in unvalidated frontend env flags.
