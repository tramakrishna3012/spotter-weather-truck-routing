# ==============================================================================
# Spotter — Weather-Aware Truck Routing Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO `.env` FOR LOCAL DEVELOPMENT:
#   cp .env.example .env
#
# SECURITY WARNING:
# - NEVER commit `.env` or any real API keys/secrets to version control.
# - All values below are safe local defaults or blank placeholders.
# - Backend validates required variables at startup and fails fast on invalid
#   production or live-mode configuration.
# - For step-by-step instructions on obtaining external keys and reviewing
#   provider licensing terms, see: docs/PREREQUISITES_AND_KEYS.md
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application Mode & Django Runtime
# ------------------------------------------------------------------------------
# Runtime environment: development | test | staging | production
# Required: All modes (fixture: default 'development', live: 'development'|'production', production: 'production')
APP_ENV=development

# Provider data source: fixture (deterministic local corpus) | live (real HERE + Open-Meteo APIs)
# Required: All modes (fixture: 'fixture', live: 'live', production: 'live')
DATA_MODE=fixture

# Django debug mode: MUST be 'false' in production (startup check rejects true in production).
# Required: All modes (fixture: true, live local: true, production: false)
DJANGO_DEBUG=true

# Cryptographic signing key for Django sessions/CSRF/signed tokens.
# Generate locally with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Required: fixture: optional (dev fallback allowed), live local: recommended, production: REQUIRED (50+ random chars)
DJANGO_SECRET_KEY=

# Primary browser origin for CSRF trusted origins and security policies.
# Required: All modes (fixture/live local: http://localhost:5173 or http://localhost:8080, production: https://your-frontend.example.com)
FRONTEND_ORIGIN=http://localhost:5173

# Comma-separated list of host/domain names Django serves. Never use '*' in production.
# Required: All modes (production: exact API hostname(s))
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of allowed CORS origins for the React SPA. Never use '*' with credentials.
# Required: All modes (production: exact HTTPS frontend origin)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Enforce Secure flag on session cookies (HTTPS only). MUST be 'true' in production.
# Required: fixture/local HTTP: false, production HTTPS: REQUIRED true
SESSION_COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 2. Frontend Build-Time Configuration (Vite — Safe Public Values ONLY)
# ------------------------------------------------------------------------------
# NEVER place private backend keys (HERE_API_KEY, OPEN_METEO_API_KEY, DJANGO_SECRET_KEY)
# in any VITE_* variable — Vite embeds VITE_* values into the public browser bundle.

# Base URL of the Spotter Django API as reached from the user's browser.
# Required: All modes (local dev: http://localhost:8000, production: https://api.your-domain.example.com)
VITE_API_BASE_URL=http://localhost:8000

# Licensed MapLibre-compatible vector/raster style JSON URL.
# MapLibre GL JS is only a client renderer — it does NOT host production map tiles.
# Obtain from a licensed tile provider (e.g., MapTiler Cloud, Stadia Maps, Protomaps, AWS Location).
# See docs/PREREQUISITES_AND_KEYS.md for provider setup and licensing requirements.
# Required: fixture: optional (uses local/fallback style), live: RECOMMENDED, production: REQUIRED (licensed style, never demo tiles)
VITE_MAP_STYLE_URL=

# Optional public browser token for your licensed map tile provider (if not embedded in VITE_MAP_STYLE_URL).
# MUST be restricted by HTTP Referer / allowed domain in your tile provider's console.
# Required: fixture: optional, live/production: optional (depends on chosen basemap provider)
VITE_MAP_PUBLIC_TOKEN=

# ------------------------------------------------------------------------------
# 3. Truck Routing & Geocoding Provider (HERE — Server-Side Only)
# ------------------------------------------------------------------------------
# HERE Platform API key with Routing API v8 + Geocoding & Search API v1 enabled.
# Obtain from: https://platform.here.com/ (see docs/PREREQUISITES_AND_KEYS.md)
# Required: fixture: NOT required (leave blank), live: REQUIRED, production: REQUIRED
HERE_API_KEY=

# HERE Routing API v8 base URL (used for transportMode=truck and alternatives=2).
# Required: live/production (keep default unless using a dedicated regional/enterprise endpoint)
HERE_ROUTING_BASE_URL=https://router.hereapi.com/v8

# HERE Geocoding & Search API v1 base URL (used for place autocomplete & disambiguation).
# Required: live/production (keep default unless using a dedicated regional/enterprise endpoint)
HERE_GEOCODING_BASE_URL=https://geocode.search.hereapi.com/v1

# ------------------------------------------------------------------------------
# 4. Weather Forecast Provider (Open-Meteo — Server-Side Only)
# ------------------------------------------------------------------------------
# Open-Meteo Forecast API base URL.
# LICENSING NOTICE:
# - Non-commercial / prototype evaluation: https://api.open-meteo.com/v1 (keyless, rate-limited, no SLA)
# - Commercial / hosted production: https://customer-api.open-meteo.com/v1 (requires paid plan + OPEN_METEO_API_KEY)
# See https://open-meteo.com/en/pricing and docs/PREREQUISITES_AND_KEYS.md
# Required: live/production
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Open-Meteo commercial API key (leave blank ONLY for non-commercial evaluation on free tier).
# Required: fixture: NOT required, live non-commercial: optional, production commercial: REQUIRED
OPEN_METEO_API_KEY=

# ------------------------------------------------------------------------------
# 5. Database, Cache & Optional Async Worker (PostgreSQL / Redis / Celery)
# ------------------------------------------------------------------------------
# PostgreSQL connection string (e.g., postgres://user:pass@host:5432/spotter?sslmode=require).
# Leave blank locally to fall back to SQLite for quick fixture development; Docker Compose sets this automatically.
# Required: fixture: optional, live local: optional, production: REQUIRED (managed PostgreSQL, non-superuser role)
DATABASE_URL=

# Redis connection string (e.g., redis://localhost:6379/0 or rediss://... for TLS in production).
# Used for weather/route response caching, distributed rate limiting, and Celery broker when async is enabled.
# Required: fixture: optional, live local: optional, production: RECOMMENDED (REQUIRED if ENABLE_ASYNC_PLANNING=true)
REDIS_URL=

# Toggle between synchronous planning (false, default) and Celery background worker execution (true).
# Both modes expose the identical /api/v1/plans API contract (see ADR-015).
# Required: fixture: false, live MVP: false, production high-fanout scale: true (requires REDIS_URL + worker)
ENABLE_ASYNC_PLANNING=false

# Concurrent Celery worker processes (and bounded provider fanout parallelism).
# Tune against your HERE and Open-Meteo rate limits.
# Required: Optional (default: 4)
PLANNING_CONCURRENCY=4

# ------------------------------------------------------------------------------
# 6. Provider Resilience, Risk Sampling & Safety Budget Guardrails
# ------------------------------------------------------------------------------
# Note: Assessment weather hazard thresholds belong in the versioned backend risk
# policy (backend/domain/risk/), NOT in unvalidated environment flags.

# Outbound HTTP connect timeout (seconds) to routing/geocoding/weather providers.
# Required: Optional (default: 5)
PROVIDER_CONNECT_TIMEOUT_SECONDS=5

# Outbound HTTP read timeout (seconds) to routing/geocoding/weather providers.
# Required: Optional (default: 20)
PROVIDER_READ_TIMEOUT_SECONDS=20

# Maximum bounded retry attempts (with backoff) on transient provider 429/5xx errors.
# Required: Optional (default: 3)
PROVIDER_MAX_ATTEMPTS=3

# Target total truck routes requested (1 primary + up to N-1 alternatives; HERE alternatives=2 -> max 3).
# Required: Optional (default: 3)
PLAN_MAX_ROUTES=3

# Internal risk-scoring checkpoint resolution in miles (independent of display spacing; see ADR-005/ADR-006).
# Required: Optional (default: 10)
INTERNAL_SCORING_MILES=10

# Default checkpoint display spacing in miles shown in UI controls (allowed: 10, 25, 50).
# Required: Optional (default: 25)
DEFAULT_DISPLAY_CHECKPOINT_MILES=25

# Maximum forecast horizon in hours accepted for trip planning (Open-Meteo standard horizon: 168h / 7 days).
# Trips extending past available forecast horizon fail closed with unknown coverage or 422.
# Required: Optional (default: 168)
FORECAST_MAX_HORIZON_HOURS=168

# Maximum wall-clock exploratory time slider range in hours from departure_instant (see ADR-014).
# Required: Optional (default: 48)
FORECAST_SLIDER_HOURS=48

# Retention TTL (seconds) for ephemeral guest trip plans and computed results.
# Required: Optional (default: 3600)
PLAN_RESULT_TTL_SECONDS=3600

# Freshness TTL (seconds) for cached hourly weather forecasts; stale data invalidates safety recommendations.
# Required: Optional (default: 900)
WEATHER_CACHE_TTL_SECONDS=900

# Hard upper bound on internal scoring checkpoints per route to prevent unbounded weather fanout.
# Required: Optional (default: 600)
MAX_CHECKPOINTS_PER_ROUTE=600

# Maximum concurrent in-flight plan computations allowed per guest session / IP scope.
# Required: Optional (default: 2)
MAX_CONCURRENT_PLANS_PER_SCOPE=2
